__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.initialWords=void 0;e.initialWords=[{id:1,wordName:'APPLE \u2014 Ma\xe7\xe3',gameTypeId:'easy',clue1Title:'It grows on a tree.',clue1Text:'It gr\xf4uz on a tr\xed.',clue1Translation:'Ela cresce em uma \xe1rvore.',clue2Title:'It can be red or green.',clue2Text:'It k\xe9n bi r\xe9d \xf3r gr\xedn.',clue2Translation:'Ela pode ser vermelha ou verde.',clue3Title:'It is a fruit you can use to make a pie.',clue3Text:'It iz a fr\xfat i\xfa k\xe9n i\xfaz tu m\xeaik a p\xe1i.',clue3Translation:'\xc9 uma fruta que voc\xea pode usar para fazer uma torta.'},{id:2,wordName:'DOG \u2014 Cachorro',gameTypeId:'easy',clue1Title:'It likes to play.',clue1Text:'It l\xe1iks tu pl\xeai.',clue1Translation:'Ele gosta de brincar.',clue2Title:'It has four legs and a tail.',clue2Text:'It r\xe9z f\xf3r l\xe9gz \xe9nd a t\xeail.',clue2Translation:'Ele tem quatro patas e um rabo.',clue3Title:'It barks when someone comes to your house.',clue3Text:'It b\xe1rks u\xe9n s\xe2muan k\xe2mz tu i\xf3r r\xe1us.',clue3Translation:'Ele late quando algu\xe9m chega \xe0 sua casa.'},{id:3,wordName:'CAT \u2014 Gato',gameTypeId:'easy',clue1Title:'It sleeps a lot.',clue1Text:'It sl\xedps a l\xe1t.',clue1Translation:'Ele dorme bastante.',clue2Title:'It can climb trees.',clue2Text:'It k\xe9n cl\xe1im tr\xedz.',clue2Translation:'Ele consegue subir em \xe1rvores.',clue3Title:'It says meow.',clue3Text:'It s\xe9z mi\xe1u.',clue3Translation:'Ele faz miau.'},{id:4,wordName:'SUN \u2014 Sol',gameTypeId:'easy',clue1Title:'You can see it in the sky.',clue1Text:'I\xfa k\xe9n s\xed it in d\xea sk\xe1i.',clue1Translation:'Voc\xea pode v\xea-lo no c\xe9u.',clue2Title:'It gives us light and heat.',clue2Text:'It gu\xedvz \xe2s l\xe1it \xe9nd r\xedt.',clue2Translation:'Ele nos d\xe1 luz e calor.',clue3Title:'It rises in the morning.',clue3Text:'It r\xe1iziz in d\xea m\xf3rnin.',clue3Translation:'Ele nasce de manh\xe3.'},{id:5,wordName:'MOON \u2014 Lua',gameTypeId:'easy',clue1Title:'It is far away from us.',clue1Text:'It iz f\xe1r au\xeai fr\xe2m \xe2s.',clue1Translation:'Ela est\xe1 longe de n\xf3s.',clue2Title:'You often see it at night.',clue2Text:'I\xfa \xf3fen s\xed it \xe9t n\xe1it.',clue2Translation:'Voc\xea costuma v\xea-la \xe0 noite.',clue3Title:'It moves around the Earth.',clue3Text:'It m\xfavz ar\xe1und di \xe2rth.',clue3Translation:'Ela se move ao redor da Terra.'},{id:6,wordName:'WATER \u2014 \xc1gua',gameTypeId:'easy',clue1Title:'We need it every day.',clue1Text:'U\xed n\xedd it \xe9vri d\xeai.',clue1Translation:'N\xf3s precisamos dela todos os dias.',clue2Title:'You use it to wash your hands.',clue2Text:'I\xfa i\xfaz it tu u\xf3sh i\xf3r r\xe9ndz.',clue2Translation:'Voc\xea a usa para lavar as m\xe3os.',clue3Title:'You drink it when you are thirsty.',clue3Text:'I\xfa dr\xednk it u\xe9n i\xfa ar th\xe2rsti.',clue3Translation:'Voc\xea a bebe quando est\xe1 com sede.'},{id:7,wordName:'BOOK \u2014 Livro',gameTypeId:'easy',clue1Title:'It can tell you a story.',clue1Text:'It k\xe9n t\xe9l i\xfa a st\xf3ri.',clue1Translation:'Ele pode contar uma hist\xf3ria para voc\xea.',clue2Title:'You can find it in a library.',clue2Text:'I\xfa k\xe9n f\xe1ind it in a l\xe1ibr\xe9ri.',clue2Translation:'Voc\xea pode encontr\xe1-lo em uma biblioteca.',clue3Title:'You open it and read its pages.',clue3Text:'I\xfa \xf4upen it \xe9nd r\xedd its p\xeaidjiz.',clue3Translation:'Voc\xea o abre e l\xea suas p\xe1ginas.'},{id:8,wordName:'CAR \u2014 Carro',gameTypeId:'easy',clue1Title:'It takes you to different places.',clue1Text:'It t\xeaiks i\xfa tu d\xedfrent pl\xeaissiz.',clue1Translation:'Ele leva voc\xea a lugares diferentes.',clue2Title:'It has four wheels.',clue2Text:'It r\xe9z f\xf3r u\xedlz.',clue2Translation:'Ele tem quatro rodas.',clue3Title:'You drive it on the road.',clue3Text:'I\xfa dr\xe1iv it on d\xea r\xf4ud.',clue3Translation:'Voc\xea o dirige na estrada.'},{id:9,wordName:'HOUSE \u2014 Casa',gameTypeId:'easy',clue1Title:'It can be big or small.',clue1Text:'It k\xe9n bi b\xedg \xf3r sm\xf3l.',clue1Translation:'Ela pode ser grande ou pequena.',clue2Title:'It has doors and windows.',clue2Text:'It r\xe9z d\xf3rz \xe9nd u\xedndouz.',clue2Translation:'Ela tem portas e janelas.',clue3Title:'A family can live in it.',clue3Text:'A f\xe9mili k\xe9n l\xedv in it.',clue3Translation:'Uma fam\xedlia pode morar nela.'},{id:10,wordName:'CHAIR \u2014 Cadeira',gameTypeId:'easy',clue1Title:'You can find it in a kitchen.',clue1Text:'I\xfa k\xe9n f\xe1ind it in a k\xedtchen.',clue1Translation:'Voc\xea pode encontr\xe1-la em uma cozinha.',clue2Title:'It usually has four legs.',clue2Text:'It i\xfaju\xe2li r\xe9z f\xf3r l\xe9gz.',clue2Translation:'Ela geralmente tem quatro pernas.',clue3Title:'You sit on it.',clue3Text:'I\xfa s\xedt on it.',clue3Translation:'Voc\xea se senta nela.'},{id:11,wordName:'BED \u2014 Cama',gameTypeId:'easy',clue1Title:'You use it every night.',clue1Text:'I\xfa i\xfaz it \xe9vri n\xe1it.',clue1Translation:'Voc\xea a usa todas as noites.',clue2Title:'It has a pillow and a blanket.',clue2Text:'It r\xe9z a p\xedlou \xe9nd a bl\xe9nkit.',clue2Translation:'Ela tem um travesseiro e um cobertor.',clue3Title:'You sleep in it.',clue3Text:'I\xfa sl\xedp in it.',clue3Translation:'Voc\xea dorme nela.'},{id:12,wordName:'PHONE \u2014 Telefone',gameTypeId:'easy',clue1Title:'You can carry it in your pocket.',clue1Text:'I\xfa k\xe9n k\xe9ri it in i\xf3r p\xe1kit.',clue1Translation:'Voc\xea pode carreg\xe1-lo no bolso.',clue2Title:'You can use it to send messages.',clue2Text:'I\xfa k\xe9n i\xfaz it tu s\xe9nd m\xe9ssidjiz.',clue2Translation:'Voc\xea pode us\xe1-lo para enviar mensagens.',clue3Title:'You use it to call your friends.',clue3Text:'I\xfa i\xfaz it tu c\xf3l i\xf3r fr\xe9ndz.',clue3Translation:'Voc\xea o usa para ligar para seus amigos.'},{id:13,wordName:'BALL \u2014 Bola',gameTypeId:'easy',clue1Title:'It comes in different sizes.',clue1Text:'It k\xe2mz in d\xedfrent s\xe1iziz.',clue1Translation:'Ela existe em tamanhos diferentes.',clue2Title:'You can throw it or catch it.',clue2Text:'I\xfa k\xe9n thr\xf4u it \xf3r k\xe9tch it.',clue2Translation:'Voc\xea pode arremess\xe1-la ou peg\xe1-la.',clue3Title:'It is round, and you kick it in soccer.',clue3Text:'It iz r\xe1und, \xe9nd i\xfa k\xedk it in s\xe1ker.',clue3Translation:'Ela \xe9 redonda, e voc\xea a chuta no futebol.'},{id:14,wordName:'SHOE \u2014 Sapato',gameTypeId:'easy',clue1Title:'You usually use two of these.',clue1Text:'I\xfa i\xfaju\xe2li i\xfaz t\xfa \xf3v d\xediz.',clue1Translation:'Voc\xea geralmente usa dois destes.',clue2Title:'You put it on before you go outside.',clue2Text:'I\xfa p\xfat it on bif\xf3r i\xfa g\xf4u auts\xe1id.',clue2Translation:'Voc\xea o coloca antes de sair.',clue3Title:'You wear it on your foot.',clue3Text:'I\xfa u\xe9r it on i\xf3r f\xfat.',clue3Translation:'Voc\xea o usa no p\xe9.'},{id:15,wordName:'FISH \u2014 Peixe',gameTypeId:'easy',clue1Title:'It is an animal.',clue1Text:'It iz an \xe9nimal.',clue1Translation:'Ele \xe9 um animal.',clue2Title:'It lives in water.',clue2Text:'It l\xedvz in u\xf3ter.',clue2Translation:'Ele vive na \xe1gua.',clue3Title:'It has fins and swims.',clue3Text:'It r\xe9z f\xednz \xe9nd su\xedmz.',clue3Translation:'Ele tem nadadeiras e nada.'},{id:16,wordName:'BIRD \u2014 P\xe1ssaro',gameTypeId:'easy',clue1Title:'You can see it in a park.',clue1Text:'I\xfa k\xe9n s\xed it in a p\xe1rk.',clue1Translation:'Voc\xea pode v\xea-lo em um parque.',clue2Title:'It has feathers and two wings.',clue2Text:'It r\xe9z f\xe9dherz \xe9nd t\xfa u\xedngz.',clue2Translation:'Ele tem penas e duas asas.',clue3Title:'It has a beak and can sing in a tree.',clue3Text:'It r\xe9z a b\xedk \xe9nd k\xe9n s\xedng in a tr\xed.',clue3Translation:'Ele tem um bico e pode cantar em uma \xe1rvore.'},{id:17,wordName:'CAKE \u2014 Bolo',gameTypeId:'easy',clue1Title:'It is something sweet.',clue1Text:'It iz s\xe2mthing su\xedt.',clue1Translation:'Ele \xe9 algo doce.',clue2Title:'You bake it in an oven.',clue2Text:'I\xfa b\xeaik it in an \xe2ven.',clue2Translation:'Voc\xea o assa em um forno.',clue3Title:'You put candles on it for a birthday.',clue3Text:'I\xfa p\xfat k\xe9ndolz on it f\xf3r a b\xe2rthd\xeai.',clue3Translation:'Voc\xea coloca velas nele para um anivers\xe1rio.'},{id:18,wordName:'TREE \u2014 \xc1rvore',gameTypeId:'easy',clue1Title:'It needs water to grow.',clue1Text:'It n\xeddz u\xf3ter tu gr\xf4u.',clue1Translation:'Ela precisa de \xe1gua para crescer.',clue2Title:'Birds can build nests in it.',clue2Text:'B\xe2rdz k\xe9n b\xedld n\xe9sts in it.',clue2Translation:'P\xe1ssaros podem construir ninhos nela.',clue3Title:'It has a trunk, branches, and leaves.',clue3Text:'It r\xe9z a tr\xe2nk, br\xe9ntchiz, \xe9nd l\xedvz.',clue3Translation:'Ela tem um tronco, galhos e folhas.'},{id:19,wordName:'SCHOOL \u2014 Escola',gameTypeId:'easy',clue1Title:'Many people go there in the morning.',clue1Text:'M\xe9ni p\xedpol g\xf4u d\xe9r in d\xea m\xf3rnin.',clue1Translation:'Muitas pessoas v\xe3o para l\xe1 de manh\xe3.',clue2Title:'You study and make friends there.',clue2Text:'I\xfa st\xe2di \xe9nd m\xeaik fr\xe9ndz d\xe9r.',clue2Translation:'Voc\xea estuda e faz amigos l\xe1.',clue3Title:'Teachers give lessons to students there.',clue3Text:'T\xedtcherz gu\xedv l\xe9ssonz tu st\xfadents d\xe9r.',clue3Translation:'Professores d\xe3o aulas aos alunos l\xe1.'},{id:20,wordName:'BANANA \u2014 Banana',gameTypeId:'easy',clue1Title:'It grows in hot places.',clue1Text:'It gr\xf4uz in r\xe1t pl\xeaissiz.',clue1Translation:'Ela cresce em lugares quentes.',clue2Title:'You peel it before you eat it.',clue2Text:'I\xfa p\xedl it bif\xf3r i\xfa \xedt it.',clue2Translation:'Voc\xea a descasca antes de com\xea-la.',clue3Title:'It is a long, yellow fruit.',clue3Text:'It iz a l\xf3ng, i\xe9lou fr\xfat.',clue3Translation:'Ela \xe9 uma fruta comprida e amarela.'},{id:21,wordName:'UMBRELLA \u2014 Guarda-chuva',gameTypeId:'medium',clue1Title:'You carry it when the weather looks bad.',clue1Text:'I\xfa k\xe9ri it u\xe9n d\xea u\xe9der l\xfaks b\xe9d.',clue1Translation:'Voc\xea o carrega quando o tempo parece ruim.',clue2Title:'You open it above your head.',clue2Text:'I\xfa \xf4upen it ab\xe2v i\xf3r r\xe9d.',clue2Translation:'Voc\xea o abre acima da cabe\xe7a.',clue3Title:'It keeps you dry when it rains.',clue3Text:'It k\xedps i\xfa dr\xe1i u\xe9n it r\xeainz.',clue3Translation:'Ele mant\xe9m voc\xea seco quando chove.'},{id:22,wordName:'MIRROR \u2014 Espelho',gameTypeId:'medium',clue1Title:'You probably use it before leaving home.',clue1Text:'I\xfa pr\xf3babli i\xfaz it bif\xf3r l\xedvin r\xf4um.',clue1Translation:'Voc\xea provavelmente o usa antes de sair de casa.',clue2Title:'You often find it above a bathroom sink.',clue2Text:'I\xfa \xf3fen f\xe1ind it ab\xe2v a b\xe9thrum s\xednk.',clue2Translation:'Voc\xea costuma encontr\xe1-lo acima de uma pia de banheiro.',clue3Title:'You look into it to see your own face.',clue3Text:'I\xfa l\xfak \xedntu it tu s\xed i\xf3r \xf4un f\xeaiss.',clue3Translation:'Voc\xea olha para ele para ver o pr\xf3prio rosto.'},{id:23,wordName:'WALLET \u2014 Carteira',gameTypeId:'medium',clue1Title:'Losing it can cause a lot of trouble.',clue1Text:'L\xfazin it k\xe9n c\xf3z a l\xe1t \xf3v tr\xe2bol.',clue1Translation:'Perd\xea-la pode causar muitos problemas.',clue2Title:'It usually fits inside a pocket or a bag.',clue2Text:'It i\xfaju\xe2li fits ins\xe1id a p\xe1kit \xf3r a b\xe9g.',clue2Translation:'Ela geralmente cabe dentro de um bolso ou de uma bolsa.',clue3Title:'You keep your money and cards in it.',clue3Text:'I\xfa k\xedp i\xf3r m\xe2ni \xe9nd c\xe1rdz in it.',clue3Translation:'Voc\xea guarda seu dinheiro e seus cart\xf5es nela.'},{id:24,wordName:'BRIDGE \u2014 Ponte',gameTypeId:'medium',clue1Title:'It connects two places.',clue1Text:'It con\xe9kts t\xfa pl\xeaissiz.',clue1Translation:'Ela conecta dois lugares.',clue2Title:'Cars and people can cross it.',clue2Text:'C\xe1rz \xe9nd p\xedpol k\xe9n cr\xf3ss it.',clue2Translation:'Carros e pessoas podem atravess\xe1-la.',clue3Title:'It lets you cross a river without getting wet.',clue3Text:'It l\xe9ts i\xfa cr\xf3ss a r\xedver uid\xe1ut gu\xe9tin u\xe9t.',clue3Translation:'Ela permite que voc\xea atravesse um rio sem se molhar.'},{id:25,wordName:'LIBRARY \u2014 Biblioteca',gameTypeId:'medium',clue1Title:'People usually speak quietly in this place.',clue1Text:'P\xedpol i\xfaju\xe2li sp\xedk qu\xe1ietli in dis pl\xeaiss.',clue1Translation:'As pessoas geralmente falam baixo neste lugar.',clue2Title:'You can go there to study or do research.',clue2Text:'I\xfa k\xe9n g\xf4u d\xe9r tu st\xe2di \xf3r du r\xeds\xe3rtch.',clue2Translation:'Voc\xea pode ir l\xe1 para estudar ou fazer pesquisas.',clue3Title:'You can borrow books there and return them later.',clue3Text:'I\xfa k\xe9n b\xe1rou b\xfaks d\xe9r \xe9nd rit\xe2rn d\xe9m l\xeaiter.',clue3Translation:'Voc\xea pode pegar livros emprestados l\xe1 e devolv\xea-los depois.'},{id:26,wordName:'SUITCASE \u2014 Mala',gameTypeId:'medium',clue1Title:'You usually use it when you travel.',clue1Text:'I\xfa i\xfaju\xe2li i\xfaz it u\xe9n i\xfa tr\xe9vol.',clue1Translation:'Voc\xea geralmente a usa quando viaja.',clue2Title:'It can have wheels and a handle.',clue2Text:'It k\xe9n r\xe9v u\xedlz \xe9nd a r\xe9ndol.',clue2Translation:'Ela pode ter rodas e uma al\xe7a.',clue3Title:'You pack your clothes in it before a trip.',clue3Text:'I\xfa p\xe9k i\xf3r cl\xf4udz in it bif\xf3r a trip.',clue3Translation:'Voc\xea coloca suas roupas nela antes de uma viagem.'},{id:27,wordName:'NEIGHBOR \u2014 Vizinho',gameTypeId:'medium',clue1Title:'This person may know your daily routine.',clue1Text:'Dis p\xe2rson m\xeai n\xf4u i\xf3r d\xeaili rut\xedn.',clue1Translation:'Essa pessoa pode conhecer sua rotina di\xe1ria.',clue2Title:'You might see this person on your street.',clue2Text:'I\xfa m\xe1it s\xed dis p\xe2rson on i\xf3r str\xedt.',clue2Translation:'Voc\xea pode ver essa pessoa na sua rua.',clue3Title:'This person lives next door or near your home.',clue3Text:'Dis p\xe2rson l\xedvz n\xe9kst d\xf3r \xf3r n\xedr i\xf3r r\xf4um.',clue3Translation:'Essa pessoa mora ao lado ou perto da sua casa.'},{id:28,wordName:'RECEIPT \u2014 Recibo',gameTypeId:'medium',clue1Title:'You might need it if you return something.',clue1Text:'I\xfa m\xe1it n\xedd it if i\xfa rit\xe2rn s\xe2mthing.',clue1Translation:'Voc\xea pode precisar dele se devolver alguma coisa.',clue2Title:'It shows how much money you spent.',clue2Text:'It sh\xf4uz r\xe1u match m\xe2ni i\xfa sp\xe9nt.',clue2Translation:'Ele mostra quanto dinheiro voc\xea gastou.',clue3Title:'A store gives it to you as proof of payment.',clue3Text:'A st\xf3r gu\xedvz it tu i\xfa \xe9z pr\xfaf \xf3v p\xeaiment.',clue3Translation:'Uma loja o entrega a voc\xea como comprovante de pagamento.'},{id:29,wordName:'LADDER \u2014 Escada de m\xe3o',gameTypeId:'medium',clue1Title:'You use it to reach high places.',clue1Text:'I\xfa i\xfaz it tu r\xedtch r\xe1i pl\xeaissiz.',clue1Translation:'Voc\xea a usa para alcan\xe7ar lugares altos.',clue2Title:'You can move it and lean it against a wall.',clue2Text:'I\xfa k\xe9n m\xfav it \xe9nd l\xedn it agu\xe9nst a u\xf3l.',clue2Translation:'Voc\xea pode mov\xea-la e apoi\xe1-la contra uma parede.',clue3Title:'You climb its steps to reach a roof.',clue3Text:'I\xfa cl\xe1im its st\xe9ps tu r\xedtch a r\xfaf.',clue3Translation:'Voc\xea sobe seus degraus para alcan\xe7ar um telhado.'},{id:30,wordName:'PILLOW \u2014 Travesseiro',gameTypeId:'medium',clue1Title:'It helps you feel comfortable while resting.',clue1Text:'It r\xe9lps i\xfa f\xedl c\xe2mfterbol u\xe1il r\xe9stin.',clue1Translation:'Ele ajuda voc\xea a se sentir confort\xe1vel enquanto descansa.',clue2Title:'It is soft and usually has a cover.',clue2Text:'It iz s\xf3ft \xe9nd i\xfaju\xe2li r\xe9z a c\xe2ver.',clue2Translation:'Ele \xe9 macio e geralmente tem uma capa.',clue3Title:'You rest your head on it when you sleep.',clue3Text:'I\xfa r\xe9st i\xf3r r\xe9d on it u\xe9n i\xfa sl\xedp.',clue3Translation:'Voc\xea apoia a cabe\xe7a nele quando dorme.'},{id:31,wordName:'KEYBOARD \u2014 Teclado',gameTypeId:'medium',clue1Title:'You use your fingers to work with it.',clue1Text:'I\xfa i\xfaz i\xf3r f\xednguerz tu u\xe2rk uid it.',clue1Translation:'Voc\xea usa os dedos para trabalhar com ele.',clue2Title:'It has letters, numbers, and symbols.',clue2Text:'It r\xe9z l\xe9terz, n\xe2mberz, \xe9nd s\xedmbolz.',clue2Translation:'Ele tem letras, n\xfameros e s\xedmbolos.',clue3Title:'You use it to type on a computer.',clue3Text:'I\xfa i\xfaz it tu t\xe1ip on a compi\xfater.',clue3Translation:'Voc\xea o usa para digitar em um computador.'},{id:32,wordName:'WHISPER \u2014 Sussurrar',gameTypeId:'medium',clue1Title:'You do this when you want to avoid making noise.',clue1Text:'I\xfa du dis u\xe9n i\xfa u\xf3nt tu av\xf3id m\xeaikin n\xf3iz.',clue1Translation:'Voc\xea faz isso quando quer evitar fazer barulho.',clue2Title:'You might do this when someone is sleeping nearby.',clue2Text:'I\xfa m\xe1it du dis u\xe9n s\xe2muan iz sl\xedpin n\xedrb\xe1i.',clue2Translation:'Voc\xea pode fazer isso quando algu\xe9m est\xe1 dormindo por perto.',clue3Title:'You speak very softly, often to tell a secret.',clue3Text:'I\xfa sp\xedk v\xe9ri s\xf3ftli, \xf3fen tu t\xe9l a s\xedcret.',clue3Translation:'Voc\xea fala bem baixinho, muitas vezes para contar um segredo.'},{id:33,wordName:'SHADOW \u2014 Sombra',gameTypeId:'medium',clue1Title:'Its shape can change during the day.',clue1Text:'Its sh\xeaip k\xe9n tch\xeaindj d\xfarin d\xea d\xeai.',clue1Translation:'O formato dela pode mudar ao longo do dia.',clue2Title:'It appears when something blocks the light.',clue2Text:'It ap\xedrz u\xe9n s\xe2mthing bl\xe1ks d\xea l\xe1it.',clue2Translation:'Ela aparece quando alguma coisa bloqueia a luz.',clue3Title:'It is the dark shape that follows you in the sun.',clue3Text:'It iz d\xea d\xe1rk sh\xeaip d\xe9t f\xf3louz i\xfa in d\xea s\xe2n.',clue3Translation:'Ela \xe9 a forma escura que acompanha voc\xea ao sol.'},{id:34,wordName:'ISLAND \u2014 Ilha',gameTypeId:'medium',clue1Title:'Some people go there on vacation.',clue1Text:'S\xe2m p\xedpol g\xf4u d\xe9r on v\xeaik\xeaishon.',clue1Translation:'Algumas pessoas v\xe3o para l\xe1 nas f\xe9rias.',clue2Title:'You may need a boat to get there.',clue2Text:'I\xfa m\xeai n\xedd a b\xf4ut tu gu\xe9t d\xe9r.',clue2Translation:'Voc\xea pode precisar de um barco para chegar l\xe1.',clue3Title:'It is a piece of land with water all around it.',clue3Text:'It iz a p\xedss \xf3v l\xe9nd uid u\xf3ter \xf3l ar\xe1und it.',clue3Translation:'Ela \xe9 uma por\xe7\xe3o de terra com \xe1gua por todos os lados.'},{id:35,wordName:'HONEY \u2014 Mel',gameTypeId:'medium',clue1Title:'You can add it to food or drinks.',clue1Text:'I\xfa k\xe9n \xe9d it tu f\xfad \xf3r dr\xednks.',clue1Translation:'Voc\xea pode adicion\xe1-lo a comidas ou bebidas.',clue2Title:'It is sweet, thick, and sticky.',clue2Text:'It iz su\xedt, th\xedk, \xe9nd st\xedki.',clue2Translation:'Ele \xe9 doce, espesso e pegajoso.',clue3Title:'Bees make it from flower nectar.',clue3Text:'B\xedz m\xeaik it fr\xe2m fl\xe1uer n\xe9ktar.',clue3Translation:'As abelhas o produzem a partir do n\xe9ctar das flores.'},{id:36,wordName:'HELMET \u2014 Capacete',gameTypeId:'medium',clue1Title:'It can protect you during an accident.',clue1Text:'It k\xe9n prot\xe9kt i\xfa d\xfarin an \xe9ksident.',clue1Translation:'Ele pode proteger voc\xea durante um acidente.',clue2Title:'It should fit well and have a strong outer shell.',clue2Text:'It shud fit u\xe9l \xe9nd r\xe9v a str\xf3ng \xe1uter sh\xe9l.',clue2Translation:'Ele deve se ajustar bem e ter uma parte externa resistente.',clue3Title:'You wear it on your head when riding a motorcycle.',clue3Text:'I\xfa u\xe9r it on i\xf3r r\xe9d u\xe9n r\xe1idin a m\xf4uters\xe1ikol.',clue3Translation:'Voc\xea o usa na cabe\xe7a ao andar de motocicleta.'},{id:37,wordName:'POCKET \u2014 Bolso',gameTypeId:'medium',clue1Title:'It is useful for carrying small things.',clue1Text:'It iz i\xfasfol f\xf3r k\xe9riin sm\xf3l thingz.',clue1Translation:'Ele \xe9 \xfatil para carregar coisas pequenas.',clue2Title:'You might put your keys or coins in it.',clue2Text:'I\xfa m\xe1it p\xfat i\xf3r k\xedz \xf3r c\xf3inz in it.',clue2Translation:'Voc\xea pode colocar suas chaves ou moedas nele.',clue3Title:'It is a small storage space sewn into your clothes.',clue3Text:'It iz a sm\xf3l st\xf3ridj sp\xeaiss s\xf4un \xedntu i\xf3r cl\xf4udz.',clue3Translation:'Ele \xe9 um pequeno espa\xe7o para guardar coisas costurado nas suas roupas.'},{id:38,wordName:'CALENDAR \u2014 Calend\xe1rio',gameTypeId:'medium',clue1Title:'It helps you organize your plans.',clue1Text:'It r\xe9lps i\xfa \xf3rguen\xe1iz i\xf3r pl\xe9nz.',clue1Translation:'Ele ajuda voc\xea a organizar seus planos.',clue2Title:'You can use it to mark birthdays and appointments.',clue2Text:'I\xfa k\xe9n i\xfaz it tu m\xe1rk b\xe2rthd\xeaiz \xe9nd ap\xf3intments.',clue2Translation:'Voc\xea pode us\xe1-lo para marcar anivers\xe1rios e compromissos.',clue3Title:'It shows the days, weeks, and months of a year.',clue3Text:'It sh\xf4uz d\xea d\xeaiz, u\xedks, \xe9nd m\xe2nths \xf3v a i\xedr.',clue3Translation:'Ele mostra os dias, as semanas e os meses de um ano.'},{id:39,wordName:'BAKERY \u2014 Padaria',gameTypeId:'medium',clue1Title:'This place often smells good early in the morning.',clue1Text:'Dis pl\xeaiss \xf3fen sm\xe9lz gud \xe2rli in d\xea m\xf3rnin.',clue1Translation:'Este lugar costuma ter um cheiro bom de manh\xe3 cedo.',clue2Title:'People work there with flour, eggs, and ovens.',clue2Text:'P\xedpol u\xe2rk d\xe9r uid fl\xe1uer, \xe9gz, \xe9nd \xe2venz.',clue2Translation:'As pessoas trabalham l\xe1 com farinha, ovos e fornos.',clue3Title:'You go there to buy fresh bread and cakes.',clue3Text:'I\xfa g\xf4u d\xe9r tu b\xe1i fr\xe9sh br\xe9d \xe9nd k\xeaiks.',clue3Translation:'Voc\xea vai l\xe1 para comprar p\xe3o fresco e bolos.'},{id:40,wordName:'GLOVES \u2014 Luvas',gameTypeId:'medium',clue1Title:'People wear them for warmth or protection.',clue1Text:'P\xedpol u\xe9r d\xe9m f\xf3r u\xf3rmth \xf3r prot\xe9kshon.',clue1Translation:'As pessoas as usam para se aquecer ou se proteger.',clue2Title:'They usually come in pairs.',clue2Text:'D\xeai i\xfaju\xe2li c\xe2m in p\xe9rz.',clue2Translation:'Elas geralmente v\xeam em pares.',clue3Title:'They cover your hands and fingers.',clue3Text:'D\xeai c\xe2ver i\xf3r r\xe9ndz \xe9nd f\xednguerz.',clue3Translation:'Elas cobrem suas m\xe3os e seus dedos.'},{id:41,wordName:'RESILIENCE \u2014 Resili\xeancia',gameTypeId:'hard',clue1Title:'Difficult experiences can help you develop it.',clue1Text:'D\xedfik\xe2lt eksp\xedriensiz k\xe9n r\xe9lp i\xfa div\xe9lop it.',clue1Translation:'Experi\xeancias dif\xedceis podem ajudar voc\xea a desenvolv\xea-la.',clue2Title:'It allows you to recover after failure or loss.',clue2Text:'It al\xe1uz i\xfa tu ric\xe2ver \xe9fter f\xeailiur \xf3r l\xf3ss.',clue2Translation:'Ela permite que voc\xea se recupere ap\xf3s um fracasso ou uma perda.',clue3Title:'It is the ability to adapt and bounce back from hardship.',clue3Text:'It iz di ab\xedliti tu ad\xe9pt \xe9nd b\xe1uns b\xe9k fr\xe2m r\xe1rdship.',clue3Translation:'\xc9 a capacidade de se adaptar e se recuperar das adversidades.'},{id:42,wordName:'THRESHOLD \u2014 Limiar',gameTypeId:'hard',clue1Title:'Crossing it can mark the beginning of something new.',clue1Text:'Cr\xf3ssin it k\xe9n m\xe1rk d\xea bigu\xednin \xf3v s\xe2mthing n\xfa.',clue1Translation:'Cruz\xe1-lo pode marcar o in\xedcio de algo novo.',clue2Title:'It can describe the level at which a reaction begins.',clue2Text:'It k\xe9n discr\xe1ib d\xea l\xe9vol \xe9t u\xedtch a ri\xe9kshon bigu\xednz.',clue2Translation:'Ele pode descrever o n\xedvel em que uma rea\xe7\xe3o come\xe7a.',clue3Title:'It can mean the bottom of a doorway or the limit of pain you can bear.',clue3Text:'It k\xe9n m\xedn d\xea b\xe1tom \xf3v a d\xf3ru\xeai \xf3r d\xea l\xedmit \xf3v p\xeain i\xfa k\xe9n b\xe9r.',clue3Translation:'Ele pode significar a soleira de uma porta ou o limite de dor que voc\xea consegue suportar.'},{id:43,wordName:'SCARCITY \u2014 Escassez',gameTypeId:'hard',clue1Title:'It can force people to make difficult choices.',clue1Text:'It k\xe9n f\xf3rss p\xedpol tu m\xeaik d\xedfik\xe2lt tch\xf3issiz.',clue1Translation:'Ela pode obrigar as pessoas a fazer escolhas dif\xedceis.',clue2Title:'It may cause prices to rise when demand stays high.',clue2Text:'It m\xeai c\xf3z pr\xe1issiz tu r\xe1iz u\xe9n dim\xe9nd st\xeaiz r\xe1i.',clue2Translation:'Ela pode fazer os pre\xe7os subirem quando a demanda permanece alta.',clue3Title:'It is a shortage of something people need, such as food or water.',clue3Text:'It iz a sh\xf3rtidj \xf3v s\xe2mthing p\xedpol n\xedd, s\xe2tch \xe9z f\xfad \xf3r u\xf3ter.',clue3Translation:'\xc9 a falta de algo de que as pessoas precisam, como comida ou \xe1gua.'},{id:44,wordName:'COMPROMISE \u2014 Acordo com concess\xf5es',gameTypeId:'hard',clue1Title:'It can help settle a disagreement.',clue1Text:'It k\xe9n r\xe9lp s\xe9tol a disag r\xedment.',clue1Translation:'Ele pode ajudar a resolver uma discord\xe2ncia.',clue2Title:'Both sides usually give up part of what they want.',clue2Text:'B\xf4uth s\xe1id z i\xfaju\xe2li gu\xedv \xe2p p\xe1rt \xf3v u\xf3t d\xeai u\xf3nt.',clue2Translation:'Os dois lados geralmente abrem m\xe3o de parte do que querem.',clue3Title:'It is an agreement reached through mutual concessions.',clue3Text:'It iz an agr\xedment r\xedtcht thru mi\xfatchu\xe2l cons \xe9shonz.',clue3Translation:'\xc9 um acordo alcan\xe7ado por meio de concess\xf5es m\xfatuas.'},{id:45,wordName:'EAVESDROP \u2014 Escutar escondido',gameTypeId:'hard',clue1Title:'Doing this can violate another person\u2019s privacy.',clue1Text:'D\xfain dis k\xe9n v\xe1iol\xeait an\xe2der p\xe2rsonz pr\xe1ivassi.',clue1Translation:'Fazer isso pode violar a privacidade de outra pessoa.',clue2Title:'You might do it while standing behind a closed door.',clue2Text:'I\xfa m\xe1it du it u\xe1il st\xe9ndin bir\xe1ind a cl\xf4uzd d\xf3r.',clue2Translation:'Voc\xea pode fazer isso enquanto est\xe1 atr\xe1s de uma porta fechada.',clue3Title:'You secretly listen to a conversation that does not include you.',clue3Text:'I\xfa s\xedcretli l\xedssen tu a convers\xeaishon d\xe9t d\xe2z n\xe1t incl\xfad i\xfa.',clue3Translation:'Voc\xea escuta secretamente uma conversa da qual n\xe3o participa.'},{id:46,wordName:'COUNTERFEIT \u2014 Falsificado',gameTypeId:'hard',clue1Title:'It may look valuable while being worth much less.',clue1Text:'It m\xeai l\xfak v\xe9liuabol u\xe1il b\xedin u\xe2rth match l\xe9ss.',clue1Translation:'Algo assim pode parecer valioso, embora valha muito menos.',clue2Title:'It imitates a genuine item in order to deceive people.',clue2Text:'It \xedmit\xeaits a dj\xe9n iu in \xe1item in \xf3rder tu diss\xedv p\xedpol.',clue2Translation:'Algo assim imita um item aut\xeantico para enganar as pessoas.',clue3Title:'This describes fake money or goods made to pass as real.',clue3Text:'Dis discr\xe1ibz f\xeaik m\xe2ni \xf3r gudz m\xeaid tu p\xe9ss \xe9z r\xedal.',clue3Translation:'Isso descreve dinheiro ou produtos falsos feitos para passar por verdadeiros.'},{id:47,wordName:'AFTERMATH \u2014 Consequ\xeancias de um acontecimento',gameTypeId:'hard',clue1Title:'It concerns what remains after a major event.',clue1Text:'It cons\xe2rnz u\xf3t rim\xeainz \xe9fter a m\xeaidjer iv\xe9nt.',clue1Translation:'Refere-se ao que permanece ap\xf3s um grande acontecimento.',clue2Title:'People may spend years dealing with it after a disaster.',clue2Text:'P\xedpol m\xeai sp\xe9nd i\xedrz d\xedlin uid it \xe9fter a diz\xe9ster.',clue2Translation:'As pessoas podem passar anos lidando com isso ap\xf3s um desastre.',clue3Title:'It is the period of consequences following a destructive event.',clue3Text:'It iz d\xea p\xedriod \xf3v c\xf3nsicu\xeansiz f\xf3louin a distr\xe2ktiv iv\xe9nt.',clue3Translation:'\xc9 o per\xedodo de consequ\xeancias que se segue a um acontecimento destrutivo.'},{id:48,wordName:'RELUCTANT \u2014 Relutante',gameTypeId:'hard',clue1Title:'This describes someone who needs extra persuasion.',clue1Text:'Dis discr\xe1ibz s\xe2muan r\xfa n\xeddz \xe9kstra persu\xeaijon.',clue1Translation:'Isso descreve algu\xe9m que precisa de mais persuas\xe3o.',clue2Title:'The person may agree, but without enthusiasm.',clue2Text:'D\xea p\xe2rson m\xeai agr\xed, b\xe2t uid\xe1ut enth\xfazi\xe9zem.',clue2Translation:'A pessoa pode concordar, mas sem entusiasmo.',clue3Title:'It means unwilling or hesitant to do something.',clue3Text:'It m\xednz anu\xedlin \xf3r r\xe9zitent tu du s\xe2mthing.',clue3Translation:'Significa estar pouco disposto ou hesitante em fazer algo.'},{id:49,wordName:'MISCONCEPTION \u2014 Ideia equivocada',gameTypeId:'hard',clue1Title:'Many people can share it and still be wrong.',clue1Text:'M\xe9ni p\xedpol k\xe9n sh\xe9r it \xe9nd stil bi r\xf3ng.',clue1Translation:'Muitas pessoas podem compartilh\xe1-la e ainda assim estar erradas.',clue2Title:'It often comes from incomplete information or misunderstanding.',clue2Text:'It \xf3fen c\xe2mz fr\xe2m incom pl\xedt inform\xeaishon \xf3r misanderst\xe9ndin.',clue2Translation:'Ela costuma surgir de informa\xe7\xf5es incompletas ou de uma interpreta\xe7\xe3o incorreta.',clue3Title:'It is a belief or idea that is mistaken.',clue3Text:'It iz a bil\xedf \xf3r aid\xeda d\xe9t iz mist\xeaiken.',clue3Translation:'\xc9 uma cren\xe7a ou ideia que est\xe1 errada.'},{id:50,wordName:'DROUGHT \u2014 Seca',gameTypeId:'hard',clue1Title:'It can threaten the survival of entire communities.',clue1Text:'It k\xe9n thr\xe9ten d\xea serv\xe1ivol \xf3v int\xe1ier comi\xfanitiz.',clue1Translation:'Ela pode amea\xe7ar a sobreviv\xeancia de comunidades inteiras.',clue2Title:'Crops may die, and rivers may become shallow.',clue2Text:'Cr\xe1ps m\xeai d\xe1i, \xe9nd r\xedverz m\xeai bic\xe2m sh\xe9lou.',clue2Translation:'As planta\xe7\xf5es podem morrer, e os rios podem ficar rasos.',clue3Title:'It is a long period with little or no rainfall.',clue3Text:'It iz a l\xf3ng p\xedriod uid l\xedtol \xf3r n\xf4u r\xeainf\xf3l.',clue3Translation:'\xc9 um longo per\xedodo com pouca ou nenhuma chuva.'},{id:51,wordName:'GRUDGE \u2014 Rancor',gameTypeId:'hard',clue1Title:'Holding onto it can damage a relationship.',clue1Text:'R\xf4uldin \xf3ntu it k\xe9n d\xe9midj a ril\xeaishonship.',clue1Translation:'Guardar isso pode prejudicar um relacionamento.',clue2Title:'It can remain long after someone has hurt you.',clue2Text:'It k\xe9n rim\xeain l\xf3ng \xe9fter s\xe2muan r\xe9z r\xe2rt i\xfa.',clue2Translation:'Ele pode permanecer muito tempo depois de algu\xe9m ter magoado voc\xea.',clue3Title:'It is lasting resentment toward someone you have not forgiven.',clue3Text:'It iz l\xe9stin riz\xe9ntment tu\xf3rd s\xe2muan i\xfa r\xe9v n\xe1t ferg\xedven.',clue3Translation:'\xc9 um ressentimento duradouro contra algu\xe9m que voc\xea n\xe3o perdoou.'},{id:52,wordName:'BYSTANDER \u2014 Espectador ocasional',gameTypeId:'hard',clue1Title:'This person is present but not directly involved.',clue1Text:'Dis p\xe2rson iz pr\xe9zent b\xe2t n\xe1t dir\xe9ktli inv\xf3lvd.',clue1Translation:'Essa pessoa est\xe1 presente, mas n\xe3o est\xe1 diretamente envolvida.',clue2Title:'They might witness an accident or an argument.',clue2Text:'D\xeai m\xe1it u\xedtness an \xe9ksident \xf3r an \xe1r guiument.',clue2Translation:'Ela pode presenciar um acidente ou uma discuss\xe3o.',clue3Title:'This is someone who stands nearby and watches an event unfold.',clue3Text:'Dis iz s\xe2muan r\xfa st\xe9ndz n\xedrb\xe1i \xe9nd u\xf3tchiz an iv\xe9nt anf\xf4uld.',clue3Translation:'\xc9 algu\xe9m que est\xe1 por perto e observa um acontecimento se desenrolar.'},{id:53,wordName:'LOOPHOLE \u2014 Brecha',gameTypeId:'hard',clue1Title:'Finding it may give someone an unexpected advantage.',clue1Text:'F\xe1indin it m\xeai gu\xedv s\xe2muan an aniksp\xe9ktid adv\xe9ntidj.',clue1Translation:'Encontr\xe1-la pode dar a algu\xe9m uma vantagem inesperada.',clue2Title:'It often exists because a rule was not written carefully enough.',clue2Text:'It \xf3fen igz\xedsts bic\xf3z a r\xfal u\xf3z n\xe1t r\xedten k\xe9rfuli in\xe2f.',clue2Translation:'Ela costuma existir porque uma regra n\xe3o foi escrita com cuidado suficiente.',clue3Title:'It is a gap in a law or rule that allows someone to avoid a restriction.',clue3Text:'It iz a gu\xe9p in a l\xf3 \xf3r r\xfal d\xe9t al\xe1uz s\xe2muan tu av\xf3id a ristr\xedkshon.',clue3Translation:'\xc9 uma falha em uma lei ou regra que permite evitar uma restri\xe7\xe3o.'},{id:54,wordName:'WANDER \u2014 Vagar',gameTypeId:'hard',clue1Title:'You can do this with your feet or your thoughts.',clue1Text:'I\xfa k\xe9n du dis uid i\xf3r f\xedt \xf3r i\xf3r th\xf3ts.',clue1Translation:'Voc\xea pode fazer isso com os p\xe9s ou com os pensamentos.',clue2Title:'You may discover unexpected places while doing it.',clue2Text:'I\xfa m\xeai disc\xe2ver aniksp\xe9ktid pl\xeaissiz u\xe1il d\xfain it.',clue2Translation:'Voc\xea pode descobrir lugares inesperados enquanto faz isso.',clue3Title:'It means to move around without a fixed route or destination.',clue3Text:'It m\xednz tu m\xfav ar\xe1und uid\xe1ut a fikst r\xfat \xf3r destin\xeaishon.',clue3Translation:'Significa andar sem uma rota ou um destino definido.'},{id:55,wordName:'FRAGILE \u2014 Fr\xe1gil',gameTypeId:'hard',clue1Title:'This can describe both an object and an emotional state.',clue1Text:'Dis k\xe9n discr\xe1ib b\xf4uth an \xe1bdjekt \xe9nd an im\xf4ushonol st\xeait.',clue1Translation:'Isso pode descrever tanto um objeto quanto um estado emocional.',clue2Title:'Something like this must be handled with care.',clue2Text:'S\xe2mthing l\xe1ik dis m\xe2st bi r\xe9ndold uid k\xe9r.',clue2Translation:'Algo assim deve ser tratado com cuidado.',clue3Title:'It means easily broken or damaged, like thin glass.',clue3Text:'It m\xednz \xedzili br\xf4uken \xf3r d\xe9midjd, l\xe1ik thin gl\xe9ss.',clue3Translation:'Significa algo que se quebra ou se danifica facilmente, como vidro fino.'},{id:56,wordName:'HEIRLOOM \u2014 Heran\xe7a de fam\xedlia',gameTypeId:'hard',clue1Title:'Its emotional value may be greater than its price.',clue1Text:'Its im\xf4ushonol v\xe9liu m\xeai bi gr\xeaiter d\xe9n its pr\xe1iss.',clue1Translation:'Seu valor emocional pode ser maior que seu pre\xe7o.',clue2Title:'It might be a ring, a watch, or a piece of furniture.',clue2Text:'It m\xe1it bi a ring, a u\xf3tch, \xf3r a p\xedss \xf3v f\xe2rnitcher.',clue2Translation:'Pode ser um anel, um rel\xf3gio ou um m\xf3vel.',clue3Title:'It is an object passed down through generations of a family.',clue3Text:'It iz an \xe1bdjekt p\xe9st d\xe1un thru d jener\xeaishonz \xf3v a f\xe9mili.',clue3Translation:'\xc9 um objeto passado de gera\xe7\xe3o em gera\xe7\xe3o em uma fam\xedlia.'},{id:57,wordName:'PROCRASTINATE \u2014 Procrastinar',gameTypeId:'hard',clue1Title:'Doing this can make a simple task more stressful.',clue1Text:'D\xfain dis k\xe9n m\xeaik a s\xedmpol t\xe9sk m\xf3r str\xe9ssfol.',clue1Translation:'Fazer isso pode tornar uma tarefa simples mais estressante.',clue2Title:'You choose a distraction even though a deadline is approaching.',clue2Text:'I\xfa tch\xfaz a distr\xe9kshon \xedven d\xf4u a d\xe9dl\xe1in iz apr\xf4utchin.',clue2Translation:'Voc\xea escolhe uma distra\xe7\xe3o mesmo com um prazo se aproximando.',clue3Title:'It means to keep delaying something you need to do.',clue3Text:'It m\xednz tu k\xedp dil\xeaiin s\xe2mthing i\xfa n\xedd tu du.',clue3Translation:'Significa continuar adiando algo que voc\xea precisa fazer.'},{id:58,wordName:'RECKLESS \u2014 Imprudente',gameTypeId:'hard',clue1Title:'This behavior can put other people in danger.',clue1Text:'Dis bir\xeaivior k\xe9n p\xfat \xe2der p\xedpol in d\xeaindjer.',clue1Translation:'Esse comportamento pode colocar outras pessoas em perigo.',clue2Title:'A person acts this way without considering the consequences.',clue2Text:'A p\xe2rson \xe9kts dis u\xeai uid\xe1ut cons\xedderin d\xea c\xf3nsicu\xeansiz.',clue2Translation:'Uma pessoa age assim sem considerar as consequ\xeancias.',clue3Title:'It describes someone who takes dangerous risks without caring about safety.',clue3Text:'It discr\xe1ibz s\xe2muan r\xfa t\xeaiks d\xeaindjeras risks uid\xe1ut k\xe9rin ab\xe1ut s\xeaifti.',clue3Translation:'Descreve algu\xe9m que corre riscos perigosos sem se importar com a seguran\xe7a.'},{id:59,wordName:'AWE \u2014 Deslumbramento',gameTypeId:'hard',clue1Title:'You may feel it when something makes you feel very small.',clue1Text:'I\xfa m\xeai f\xedl it u\xe9n s\xe2mthing m\xeaiks i\xfa f\xedl v\xe9ri sm\xf3l.',clue1Translation:'Voc\xea pode sentir isso quando algo faz voc\xea se sentir muito pequeno.',clue2Title:'A vast landscape or an extraordinary achievement can inspire it.',clue2Text:'A v\xe9st l\xe9ndsk\xeaip \xf3r an ikstr\xf3rdin\xe9ri atch\xedvment k\xe9n insp\xe1ier it.',clue2Translation:'Uma paisagem imensa ou uma conquista extraordin\xe1ria pode despertar isso.',clue3Title:'It is a strong feeling of wonder and respect, sometimes mixed with fear.',clue3Text:'It iz a str\xf3ng f\xedlin \xf3v u\xe2nder \xe9nd risp\xe9kt, s\xe2m t\xe1imz mikst uid f\xedr.',clue3Translation:'\xc9 um forte sentimento de admira\xe7\xe3o e respeito, \xe0s vezes misturado com medo.'},{id:60,wordName:'SERENDIPITY \u2014 Descoberta feliz por acaso',gameTypeId:'hard',clue1Title:'It cannot be fully planned or predicted.',clue1Text:'It k\xe9n\xe1t bi f\xfali pl\xe9nd \xf3r prid\xedktid.',clue1Translation:'Ela n\xe3o pode ser totalmente planejada ou prevista.',clue2Title:'You experience it when you find something valuable while looking for something else.',clue2Text:'I\xfa iksp\xedriens it u\xe9n i\xfa f\xe1ind s\xe2mthing v\xe9liuabol u\xe1il l\xfakin f\xf3r s\xe2mthing \xe9ls.',clue2Translation:'Voc\xea a vivencia quando encontra algo valioso enquanto procura outra coisa.',clue3Title:'It is the chance discovery of something good or useful.',clue3Text:'It iz d\xea tch\xe9ns disc\xe2veri \xf3v s\xe2mthing gud \xf3r i\xfasfol.',clue3Translation:'\xc9 a descoberta por acaso de algo bom ou \xfatil.'},{id:61,wordName:'BACK TO THE FUTURE \u2014 De Volta para o Futuro',gameTypeId:'Movie80s',clue1Title:'A teenager accidentally meets his parents when they were young.',clue1Text:'A t\xedn\xeaidjer \xe9ksidentali m\xedts riz p\xe9rents u\xe9n d\xeai u\xe2r i\xe2ng.',clue1Translation:'Um adolescente encontra seus pais por acidente quando eles eram jovens.',clue2Title:'A scientist turns a sports car into a time machine.',clue2Text:'A s\xe1iantist t\xe2rnz a sp\xf3rts c\xe1r \xedntu a t\xe1im mash\xedn.',clue2Translation:'Um cientista transforma um carro esportivo em uma m\xe1quina do tempo.',clue3Title:'Marty McFly must drive a DeLorean at eighty-eight miles per hour.',clue3Text:'M\xe1rti Macfl\xe1i m\xe2st dr\xe1iv a Del\xf3rian \xe9t \xeaiti-\xeait m\xe1ilz per \xe1uer.',clue3Translation:'Marty McFly precisa dirigir um DeLorean a oitenta e oito milhas por hora.'},{id:62,wordName:'E.T. THE EXTRA-TERRESTRIAL \u2014 E.T.: O Extraterrestre',gameTypeId:'Movie80s',clue1Title:'A lonely boy makes a friend from another world.',clue1Text:'A l\xf4unli b\xf3i m\xeaiks a fr\xe9nd fr\xe2m an\xe2der u\xe2rld.',clue1Translation:'Um menino solit\xe1rio faz amizade com algu\xe9m de outro mundo.',clue2Title:'A bicycle flies across the sky in front of the moon.',clue2Text:'A b\xe1issicol fl\xe1iz acr\xf3ss d\xea sk\xe1i in fr\xe2nt \xf3v d\xea m\xfan.',clue2Translation:'Uma bicicleta voa pelo c\xe9u em frente \xe0 lua.',clue3Title:'Elliott helps a small alien who wants to phone home.',clue3Text:'\xc9liot r\xe9lps a sm\xf3l \xeailian r\xfa u\xf3nts tu f\xf4un r\xf4um.',clue3Translation:'Elliott ajuda um pequeno alien\xedgena que quer telefonar para casa.'},{id:63,wordName:'GHOSTBUSTERS \u2014 Os Ca\xe7a-Fantasmas',gameTypeId:'Movie80s',clue1Title:'Some scientists start an unusual business in New York.',clue1Text:'S\xe2m s\xe1iantists st\xe1rt an ani\xfaju\xe2l b\xedzness in N\xfa I\xf3rk.',clue1Translation:'Alguns cientistas come\xe7am um neg\xf3cio incomum em Nova York.',clue2Title:'They carry special equipment on their backs to catch spirits.',clue2Text:'D\xeai k\xe9ri sp\xe9shol iku\xedpment on d\xe9r b\xe9ks tu k\xe9tch sp\xedrits.',clue2Translation:'Eles carregam equipamentos especiais nas costas para capturar esp\xedritos.',clue3Title:'Their enemies include a green ghost and a giant marshmallow man.',clue3Text:'D\xe9r \xe9nemiz incl\xfad a gr\xedn g\xf4ust \xe9nd a dj\xe1iant m\xe1rshm\xe9lou m\xe9n.',clue3Translation:'Seus inimigos incluem um fantasma verde e um homem gigante de marshmallow.'},{id:64,wordName:'THE KARATE KID \u2014 Karat\xea Kid: A Hora da Verdade',gameTypeId:'Movie80s',clue1Title:'A teenager moves to a new town and faces bullies.',clue1Text:'A t\xedn\xeaidjer m\xfavz tu a n\xfa t\xe1un \xe9nd f\xeaissiz b\xfaliz.',clue1Translation:'Um adolescente se muda para uma nova cidade e enfrenta valent\xf5es.',clue2Title:'His teacher makes him wash cars and paint fences.',clue2Text:'Riz t\xedtcher m\xeaiks rim u\xf3sh c\xe1rz \xe9nd p\xeaint f\xe9nsiz.',clue2Translation:'Seu professor o faz lavar carros e pintar cercas.',clue3Title:'Mr. Miyagi trains Daniel to fight in a karate tournament.',clue3Text:'M\xedster Mi\xe1 gui tr\xeainz D\xe9niel tu f\xe1it in a car\xe1ti t\xfbrnament.',clue3Translation:'O senhor Miyagi treina Daniel para lutar em um torneio de carat\xea.'},{id:65,wordName:'THE TERMINATOR \u2014 O Exterminador do Futuro',gameTypeId:'Movie80s',clue1Title:'The future of humanity depends on a woman surviving.',clue1Text:'D\xea fi\xfa tcher \xf3v rium\xe9niti dip\xe9ndz on a u\xfaman serv\xe1ivin.',clue1Translation:'O futuro da humanidade depende da sobreviv\xeancia de uma mulher.',clue2Title:'A deadly machine travels back in time to kill her.',clue2Text:'A d\xe9dli mash\xedn tr\xe1velz b\xe9k in t\xe1im tu kil r\xe2r.',clue2Translation:'Uma m\xe1quina mortal viaja de volta no tempo para mat\xe1-la.',clue3Title:'Arnold Schwarzenegger plays a cyborg sent to kill Sarah Connor.',clue3Text:'\xc1rnold Shu\xf3rtsen\xe9 guer pl\xeaiz a s\xe1ib\xf3rg s\xe9nt tu kil S\xe9ra C\xe1ner.',clue3Translation:'Arnold Schwarzenegger interpreta um ciborgue enviado para matar Sarah Connor.'},{id:66,wordName:'TOP GUN \u2014 Top Gun: Ases Indom\xe1veis',gameTypeId:'Movie80s',clue1Title:'A talented young man must learn to control his reckless behavior.',clue1Text:'A t\xe9lentid i\xe2ng m\xe9n m\xe2st l\xe2rn tu contr\xf4ul riz r\xe9kless bir\xeaivior.',clue1Translation:'Um jovem talentoso precisa aprender a controlar seu comportamento imprudente.',clue2Title:'He competes with other pilots at an elite Navy school.',clue2Text:'Ri comp\xedts uid \xe2der p\xe1ilots \xe9t an il\xedt n\xeaivi sk\xfal.',clue2Translation:'Ele compete com outros pilotos em uma escola de elite da Marinha.',clue3Title:'Tom Cruise plays Maverick, a fighter pilot whose partner is Goose.',clue3Text:'T\xf3m Cr\xfaz pl\xeaiz M\xe9verik, a f\xe1iter p\xe1ilot r\xfaz p\xe1rtner iz G\xfass.',clue3Translation:'Tom Cruise interpreta Maverick, um piloto de ca\xe7a cujo parceiro \xe9 Goose.'},{id:67,wordName:'DIRTY DANCING \u2014 Dirty Dancing: Ritmo Quente',gameTypeId:'Movie80s',clue1Title:'A young woman spends the summer at a resort with her family.',clue1Text:'A i\xe2ng u\xfaman sp\xe9ndz d\xea s\xe2mer \xe9t a riz\xf3rt uid r\xe2r f\xe9mili.',clue1Translation:'Uma jovem passa o ver\xe3o em um resort com sua fam\xedlia.',clue2Title:'She falls in love with a dance instructor.',clue2Text:'Shi f\xf3lz in l\xe2v uid a d\xe9ns instr\xe2ktor.',clue2Translation:'Ela se apaixona por um instrutor de dan\xe7a.',clue3Title:'Baby and Johnny perform a famous dance lift in the final scene.',clue3Text:'B\xeaibi \xe9nd Dj\xf3ni perf\xf3rm a f\xeaimos d\xe9ns lift in d\xea f\xe1inol s\xedn.',clue3Translation:'Baby e Johnny fazem uma famosa eleva\xe7\xe3o de dan\xe7a na cena final.'},{id:68,wordName:'THE GOONIES \u2014 Os Goonies',gameTypeId:'Movie80s',clue1Title:'A group of children tries to save their neighborhood.',clue1Text:'A gr\xfap \xf3v tch\xedldren tr\xe1iz tu s\xeaiv d\xe9r n\xeaiber rud.',clue1Translation:'Um grupo de crian\xe7as tenta salvar seu bairro.',clue2Title:'An old map leads them into underground tunnels full of traps.',clue2Text:'An \xf4uld m\xe9p l\xeddz d\xe9m \xedntu \xe2nderg r\xe1und t\xe2nolz ful \xf3v tr\xe9ps.',clue2Translation:'Um mapa antigo os leva a t\xfaneis subterr\xe2neos cheios de armadilhas.',clue3Title:'Mikey and his friends search for the treasure of One-Eyed Willy.',clue3Text:'M\xe1iki \xe9nd riz fr\xe9ndz s\xe2rtch f\xf3r d\xea tr\xe9jer \xf3v U\xe2n-\xe1id U\xedli.',clue3Translation:'Mikey e seus amigos procuram o tesouro de Willy Caolho.'},{id:69,wordName:'GREMLINS \u2014 Gremlins',gameTypeId:'Movie80s',clue1Title:'An unusual Christmas gift causes trouble in a small town.',clue1Text:'An ani\xfaju\xe2l Cr\xedssmas gift c\xf3ziz tr\xe2bol in a sm\xf3l t\xe1un.',clue1Translation:'Um presente de Natal incomum causa problemas em uma pequena cidade.',clue2Title:'The creature must stay away from bright light and water.',clue2Text:'D\xea cr\xed tcher m\xe2st st\xeai au\xeai fr\xe2m br\xe1it l\xe1it \xe9nd u\xf3ter.',clue2Translation:'A criatura deve ficar longe de luz forte e de \xe1gua.',clue3Title:'Gizmo is a cute creature that must never be fed after midnight.',clue3Text:'Gu\xedz mou iz a ki\xfat cr\xed tcher d\xe9t m\xe2st n\xe9ver bi f\xe9d \xe9fter m\xeddn\xe1it.',clue3Translation:'Gizmo \xe9 uma criatura fofa que nunca deve ser alimentada depois da meia-noite.'},{id:70,wordName:'RAIDERS OF THE LOST ARK \u2014 Os Ca\xe7adores da Arca Perdida',gameTypeId:'Movie80s',clue1Title:'An adventurer searches for an ancient object with mysterious powers.',clue1Text:'An adv\xe9n tcherer s\xe2rtchiz f\xf3r an \xeainshent \xe1bdjekt uid mist\xedrias p\xe1uerz.',clue1Translation:'Um aventureiro procura um objeto antigo com poderes misteriosos.',clue2Title:'He must find a sacred chest before the Nazis do.',clue2Text:'Ri m\xe2st f\xe1ind a s\xeaicrid tch\xe9st bif\xf3r d\xea n\xe1tsiz du.',clue2Translation:'Ele precisa encontrar um ba\xfa sagrado antes dos nazistas.',clue3Title:'Indiana Jones uses a whip and searches for the Ark of the Covenant.',clue3Text:'Indi \xe9na Dj\xf4unz i\xfaziz a u\xedp \xe9nd s\xe2rtchiz f\xf3r di \xe1rk \xf3v d\xea c\xe2venant.',clue3Translation:'Indiana Jones usa um chicote e procura a Arca da Alian\xe7a.'},{id:71,wordName:'THE SHINING \u2014 O Iluminado',gameTypeId:'Movie80s',clue1Title:'A family spends the winter in an isolated hotel.',clue1Text:'A f\xe9mili sp\xe9ndz d\xea u\xednter in an \xe1issol\xeaitid rout\xe9l.',clue1Translation:'Uma fam\xedlia passa o inverno em um hotel isolado.',clue2Title:'The father becomes violent while his son sees terrifying visions.',clue2Text:'D\xea f\xe1der bic\xe2mz v\xe1iolent u\xe1il riz s\xe2n s\xedz t\xe9rifaiin v\xedjonz.',clue2Translation:'O pai se torna violento enquanto seu filho tem vis\xf5es assustadoras.',clue3Title:'Jack Nicholson breaks through a bathroom door with an axe.',clue3Text:'Dj\xe9k N\xedcolson br\xeaiks thru a b\xe9thrum d\xf3r uid an \xe9ks.',clue3Translation:'Jack Nicholson arromba uma porta de banheiro com um machado.'},{id:72,wordName:'THE BREAKFAST CLUB \u2014 Clube dos Cinco',gameTypeId:'Movie80s',clue1Title:'Very different teenagers discover that they have things in common.',clue1Text:'V\xe9ri d\xedfrent t\xedn\xeaidjerz disc\xe2ver d\xe9t d\xeai r\xe9v thingz in c\xf3mon.',clue1Translation:'Adolescentes muito diferentes descobrem que t\xeam coisas em comum.',clue2Title:'They spend a Saturday together as punishment at school.',clue2Text:'D\xeai sp\xe9nd a S\xe9terd\xeai tugu\xe9der \xe9z p\xe2nishment \xe9t sk\xfal.',clue2Translation:'Eles passam um s\xe1bado juntos como castigo na escola.',clue3Title:'Five students share their stories during detention in a school library.',clue3Text:'F\xe1iv st\xfadents sh\xe9r d\xe9r st\xf3riz d\xfarin dit\xe9 nshon in a sk\xfal l\xe1ibr\xe9ri.',clue3Translation:'Cinco estudantes compartilham suas hist\xf3rias durante uma deten\xe7\xe3o na biblioteca da escola.'},{id:73,wordName:'FERRIS BUELLER\u2019S DAY OFF \u2014 Curtindo a Vida Adoidado',gameTypeId:'Movie80s',clue1Title:'A clever teenager decides to break the rules for one day.',clue1Text:'A cl\xe9ver t\xedn\xeaidjer diss\xe1idz tu br\xeaik d\xea r\xfalz f\xf3r u\xe2n d\xeai.',clue1Translation:'Um adolescente esperto decide quebrar as regras por um dia.',clue2Title:'He skips school and explores Chicago with two friends.',clue2Text:'Ri skips sk\xfal \xe9nd ikspl\xf3rz Shic\xe1gou uid t\xfa fr\xe9ndz.',clue2Translation:'Ele falta \xe0 aula e explora Chicago com dois amigos.',clue3Title:'Ferris borrows a Ferrari and sings on a parade float.',clue3Text:'F\xe9ris b\xe1rouz a Fer\xe1ri \xe9nd singz on a per\xeaid fl\xf4ut.',clue3Translation:'Ferris pega uma Ferrari emprestada e canta em um carro aleg\xf3rico.'},{id:74,wordName:'ROBOCOP \u2014 RoboCop: O Policial do Futuro',gameTypeId:'Movie80s',clue1Title:'A company uses technology to create a new kind of law enforcement.',clue1Text:'A c\xe2mpani i\xfaziz tekn\xf3lodji tu cri\xeait a n\xfa c\xe1ind \xf3v l\xf3 inf\xf3rsment.',clue1Translation:'Uma empresa usa tecnologia para criar um novo tipo de policiamento.',clue2Title:'A police officer returns as a machine after a brutal attack.',clue2Text:'A pol\xedss \xf3fisser rit\xe2rnz \xe9z a mash\xedn \xe9fter a br\xfa tol at\xe9k.',clue2Translation:'Um policial retorna como uma m\xe1quina ap\xf3s um ataque brutal.',clue3Title:'Alex Murphy becomes a cyborg police officer in Detroit.',clue3Text:'\xc9liks M\xe2rfi bic\xe2mz a s\xe1ib\xf3rg pol\xedss \xf3fisser in Ditr\xf3it.',clue3Translation:'Alex Murphy se torna um policial ciborgue em Detroit.'},{id:75,wordName:'PREDATOR \u2014 O Predador',gameTypeId:'Movie80s',clue1Title:'A military mission becomes a struggle for survival.',clue1Text:'A m\xedliteri m\xedshon bic\xe2mz a str\xe2gol f\xf3r serv\xe1ivol.',clue1Translation:'Uma miss\xe3o militar se transforma em uma luta pela sobreviv\xeancia.',clue2Title:'An almost invisible enemy hunts soldiers in the jungle.',clue2Text:'An \xf3lmoust inv\xedzabol \xe9nemi r\xe2nts s\xf4uldjerz in d\xea dj\xe2ngol.',clue2Translation:'Um inimigo quase invis\xedvel ca\xe7a soldados na selva.',clue3Title:'Arnold Schwarzenegger fights an alien hunter that can see body heat.',clue3Text:'\xc1rnold Shu\xf3rtsen\xe9 guer f\xe1its an \xeailian r\xe2nter d\xe9t k\xe9n s\xed b\xe1di r\xedt.',clue3Translation:'Arnold Schwarzenegger enfrenta um ca\xe7ador alien\xedgena que consegue enxergar o calor corporal.'},{id:76,wordName:'DIE HARD \u2014 Duro de Matar',gameTypeId:'Movie80s',clue1Title:'A man visits his wife during a Christmas party at her workplace.',clue1Text:'A m\xe9n v\xedzits riz u\xe1if d\xfarin a Cr\xedssmas p\xe1rti \xe9t r\xe2r u\xe2rkpl\xeaiss.',clue1Translation:'Um homem visita sua esposa durante uma festa de Natal no trabalho dela.',clue2Title:'Armed criminals take control of the building, but he escapes.',clue2Text:'\xc1rmd cr\xedminolz t\xeaik contr\xf4ul \xf3v d\xea b\xedldin, b\xe2t ri is k\xeaips.',clue2Translation:'Criminosos armados assumem o controle do pr\xe9dio, mas ele escapa.',clue3Title:'Bruce Willis plays John McClane, a barefoot cop fighting in Nakatomi Plaza.',clue3Text:'Br\xfass U\xedlis pl\xeaiz Djon Macl\xeain, a b\xe9rfut c\xe1p f\xe1itin in Nakat\xf4mi Pl\xe1za.',clue3Translation:'Bruce Willis interpreta John McClane, um policial descal\xe7o lutando no Nakatomi Plaza.'},{id:77,wordName:'BEETLEJUICE \u2014 Os Fantasmas se Divertem',gameTypeId:'Movie80s',clue1Title:'A dead couple wants to remove the new residents from their house.',clue1Text:'A d\xe9d c\xe2pol u\xf3nts tu rim\xfav d\xea n\xfa r\xe9zidents fr\xe2m d\xe9r r\xe1us.',clue1Translation:'Um casal morto quer expulsar os novos moradores de sua casa.',clue2Title:'They ask a rude and unpredictable spirit for help.',clue2Text:'D\xeai \xe9sk a r\xfad \xe9nd anprid\xedktabol sp\xedrit f\xf3r r\xe9lp.',clue2Translation:'Eles pedem ajuda a um esp\xedrito grosseiro e imprevis\xedvel.',clue3Title:'A ghost in a striped suit appears when his name is said three times.',clue3Text:'A g\xf4ust in a str\xe1ipt s\xfat ap\xedrz u\xe9n riz n\xeaim iz s\xe9d thr\xed t\xe1imz.',clue3Translation:'Um fantasma de terno listrado aparece quando seu nome \xe9 dito tr\xeas vezes.'},{id:78,wordName:'THE NEVERENDING STORY \u2014 A Hist\xf3ria sem Fim',gameTypeId:'Movie80s',clue1Title:'A boy discovers that reading can connect him to another world.',clue1Text:'A b\xf3i disc\xe2verz d\xe9t r\xeddin k\xe9n con\xe9kt rim tu an\xe2der u\xe2rld.',clue1Translation:'Um menino descobre que a leitura pode conect\xe1-lo a outro mundo.',clue2Title:'A young hero must save a magical land from the Nothing.',clue2Text:'A i\xe2ng r\xedrou m\xe2st s\xeaiv a m\xe9djicol l\xe9nd fr\xe2m d\xea N\xe2thing.',clue2Translation:'Um jovem her\xf3i precisa salvar uma terra m\xe1gica do Nada.',clue3Title:'Atreyu travels with Falkor, a white luckdragon.',clue3Text:'A tr\xeaiu tr\xe1velz uid F\xe1lcor, a u\xe1it l\xe2kdr\xe9gon.',clue3Translation:'Atreyu viaja com Falkor, um drag\xe3o branco da sorte.'},{id:79,wordName:'COMING TO AMERICA \u2014 Um Pr\xedncipe em Nova York',gameTypeId:'Movie80s',clue1Title:'A wealthy young man hides his identity to find true love.',clue1Text:'A u\xe9lthi i\xe2ng m\xe9n r\xe1idz riz aid\xe9ntiti tu f\xe1ind tr\xfa l\xe2v.',clue1Translation:'Um jovem rico esconde sua identidade para encontrar o amor verdadeiro.',clue2Title:'He leaves an African kingdom and gets a job at a fast-food restaurant.',clue2Text:'Ri l\xedvz an \xc9frican k\xedngdom \xe9nd gu\xe9ts a dj\xe1b \xe9t a f\xe9st-f\xfad r\xe9storant.',clue2Translation:'Ele deixa um reino africano e consegue um emprego em um restaurante de fast-food.',clue3Title:'Eddie Murphy plays Prince Akeem, who searches for a bride in Queens.',clue3Text:'\xc9di M\xe2rfi pl\xeaiz Prins Ak\xedm, r\xfa s\xe2rtchiz f\xf3r a br\xe1id in Cu\xednz.',clue3Translation:'Eddie Murphy interpreta o pr\xedncipe Akeem, que procura uma noiva no Queens.'},{id:80,wordName:'DEAD POETS SOCIETY \u2014 Sociedade dos Poetas Mortos',gameTypeId:'Movie80s',clue1Title:'A new teacher challenges the traditions of a strict school.',clue1Text:'A n\xfa t\xedtcher tch\xe9lindjiz d\xea trad\xedshonz \xf3v a strikt sk\xfal.',clue1Translation:'Um novo professor desafia as tradi\xe7\xf5es de uma escola r\xedgida.',clue2Title:'He uses poetry to encourage his students to think for themselves.',clue2Text:'Ri i\xfaziz p\xf4uetri tu enc\xe2ridj riz st\xfadents tu think f\xf3r dems\xe9lvz.',clue2Translation:'Ele usa a poesia para incentivar seus alunos a pensar por conta pr\xf3pria.',clue3Title:'Robin Williams plays a teacher whose students stand on desks to honor him.',clue3Text:'R\xe1bin U\xedliamz pl\xeaiz a t\xedtcher r\xfaz st\xfadents st\xe9nd on d\xe9sks tu \xe1ner rim.',clue3Translation:'Robin Williams interpreta um professor cujos alunos sobem nas carteiras para homenage\xe1-lo.'},{id:81,wordName:'LEGI\xc3O URBANA',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band became famous for songs about youth, love, and society.',clue1Text:'Dis b\xe9nd bic\xeaim f\xeaimos f\xf3r s\xf3ngz ab\xe1ut i\xfath, l\xe2v, \xe9nd sos\xe1iati.',clue1Translation:'Esta banda ficou famosa por m\xfasicas sobre juventude, amor e sociedade.',clue2Title:'It was formed in Bras\xedlia and had Renato Russo as its lead singer.',clue2Text:'It u\xf3z f\xf3rmd in Braz\xedlia \xe9nd r\xe9d Renato Russo \xe9z its l\xedd s\xednger.',clue2Translation:'Ela foi formada em Bras\xedlia e tinha Renato Russo como vocalista.',clue3Title:'Its hits include Eduardo e M\xf4nica and Faroeste Caboclo.',clue3Text:'Its r\xedts incl\xfad Eduardo e M\xf4nica \xe9nd Faroeste Caboclo.',clue3Translation:'Seus sucessos incluem Eduardo e M\xf4nica e Faroeste Caboclo.'},{id:82,wordName:'RAUL SEIXAS',gameTypeId:'namesOfBrazilianRock',clue1Title:'This singer mixed rock with philosophy and Brazilian rhythms.',clue1Text:'Dis s\xednger mikst r\xf3k uid fil\xf3safi \xe9nd Braz\xedlian r\xeddhamz.',clue1Translation:'Este cantor misturou rock com filosofia e ritmos brasileiros.',clue2Title:'He was born in Salvador and wrote songs with Paulo Coelho.',clue2Text:'Ri u\xf3z b\xf3rn in Salvador \xe9nd r\xf4ut s\xf3ngz uid Paulo Coelho.',clue2Translation:'Ele nasceu em Salvador e escreveu m\xfasicas com Paulo Coelho.',clue3Title:'He sang Maluco Beleza and Metamorfose Ambulante.',clue3Text:'Ri s\xe9ng Maluco Beleza \xe9nd Metamorfose Ambulante.',clue3Translation:'Ele cantou Maluco Beleza e Metamorfose Ambulante.'},{id:83,wordName:'RITA LEE',gameTypeId:'namesOfBrazilianRock',clue1Title:'Humor and a rebellious attitude were important parts of her music.',clue1Text:'Ri\xfamor \xe9nd a rib\xe9li\xe3s \xe9titud u\xe2r imp\xf3rtent p\xe1rts \xf3v r\xe2r mi\xfazik.',clue1Translation:'O humor e uma atitude rebelde eram partes importantes de sua m\xfasica.',clue2Title:'She was a member of Os Mutantes before becoming a successful solo artist.',clue2Text:'Shi u\xf3z a m\xe9mber \xf3v Os Mutantes bif\xf3r bic\xe2min a saks\xe9ssfol s\xf4ulou \xe1rtist.',clue2Translation:'Ela integrou Os Mutantes antes de se tornar uma artista solo de sucesso.',clue3Title:'Known as the queen of Brazilian rock, she sang Ovelha Negra and Lan\xe7a Perfume.',clue3Text:'N\xf4un \xe9z d\xea cu\xedn \xf3v Braz\xedlian r\xf3k, shi s\xe9ng Ovelha Negra \xe9nd Lan\xe7a Perfume.',clue3Translation:'Conhecida como a rainha do rock brasileiro, ela cantou Ovelha Negra e Lan\xe7a Perfume.'},{id:84,wordName:'CAZUZA',gameTypeId:'namesOfBrazilianRock',clue1Title:'His lyrics often explored passion, freedom, and social criticism.',clue1Text:'Riz l\xedriks \xf3fen ikspl\xf3rd p\xe9shon, fr\xeddom, \xe9nd s\xf4ushol cr\xedtisizem.',clue1Translation:'Suas letras frequentemente exploravam paix\xe3o, liberdade e cr\xedtica social.',clue2Title:'He was the lead singer of Bar\xe3o Vermelho before starting a solo career.',clue2Text:'Ri u\xf3z d\xea l\xedd s\xednger \xf3v Bar\xe3o Vermelho bif\xf3r st\xe1rtin a s\xf4ulou car\xedr.',clue2Translation:'Ele foi vocalista do Bar\xe3o Vermelho antes de iniciar uma carreira solo.',clue3Title:'His solo hits include Ideologia and O Tempo N\xe3o Para.',clue3Text:'Riz s\xf4ulou r\xedts incl\xfad Ideologia \xe9nd O Tempo N\xe3o Para.',clue3Translation:'Seus sucessos solo incluem Ideologia e O Tempo N\xe3o Para.'},{id:85,wordName:'OS PARALAMAS DO SUCESSO',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band combines rock with reggae and ska.',clue1Text:'Dis b\xe9nd comb\xe1inz r\xf3k uid r\xe9guei \xe9nd sk\xe1.',clue1Translation:'Esta banda combina rock com reggae e ska.',clue2Title:'Its famous trio includes Herbert Vianna, Bi Ribeiro, and Jo\xe3o Barone.',clue2Text:'Its f\xeaimos tr\xedou incl\xfadz Herbert Vianna, Bi Ribeiro, \xe9nd Jo\xe3o Barone.',clue2Translation:'Seu famoso trio inclui Herbert Vianna, Bi Ribeiro e Jo\xe3o Barone.',clue3Title:'The band recorded Meu Erro, Alagados, and Lanterna dos Afogados.',clue3Text:'D\xea b\xe9nd ric\xf3rdid Meu Erro, Alagados, \xe9nd Lanterna dos Afogados.',clue3Translation:'A banda gravou Meu Erro, Alagados e Lanterna dos Afogados.'},{id:86,wordName:'TIT\xc3S',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band from S\xe3o Paulo explored several styles, including punk and pop rock.',clue1Text:'Dis b\xe9nd fr\xe2m S\xe3o Paulo ikspl\xf3rd s\xe9vrol st\xe1 ilz, incl\xfadin p\xe2nk \xe9nd p\xf3p r\xf3k.',clue1Translation:'Esta banda de S\xe3o Paulo explorou v\xe1rios estilos, incluindo punk e pop rock.',clue2Title:'Arnaldo Antunes and Nando Reis were among its members.',clue2Text:'Arnaldo Antunes \xe9nd Nando Reis u\xe2r am\xe2ng its m\xe9mberz.',clue2Translation:'Arnaldo Antunes e Nando Reis estiveram entre seus integrantes.',clue3Title:'Its songs include Pol\xedcia, Comida, and Epit\xe1fio.',clue3Text:'Its s\xf3ngz incl\xfad Pol\xedcia, Comida, \xe9nd Epit\xe1fio.',clue3Translation:'Suas m\xfasicas incluem Pol\xedcia, Comida e Epit\xe1fio.'},{id:87,wordName:'BAR\xc3O VERMELHO',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band emerged from the rock scene in Rio de Janeiro.',clue1Text:'Dis b\xe9nd im\xe2rdjd fr\xe2m d\xea r\xf3k s\xedn in Rio de Janeiro.',clue1Translation:'Esta banda surgiu na cena do rock do Rio de Janeiro.',clue2Title:'Frejat became its lead singer after Cazuza left.',clue2Text:'Frejat bic\xeaim its l\xedd s\xednger \xe9fter Cazuza l\xe9ft.',clue2Translation:'Frejat se tornou seu vocalista depois da sa\xedda de Cazuza.',clue3Title:'Its hits include Bete Balan\xe7o and Pro Dia Nascer Feliz.',clue3Text:'Its r\xedts incl\xfad Bete Balan\xe7o \xe9nd Pro Dia Nascer Feliz.',clue3Translation:'Seus sucessos incluem Bete Balan\xe7o e Pro Dia Nascer Feliz.'},{id:88,wordName:'ENGENHEIROS DO HAWAII',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band became known for lyrics full of wordplay and questions.',clue1Text:'Dis b\xe9nd bic\xeaim n\xf4un f\xf3r l\xedriks ful \xf3v u\xe2rdpl\xeai \xe9nd cu\xe9stchonz.',clue1Translation:'Esta banda ficou conhecida por letras cheias de jogos de palavras e questionamentos.',clue2Title:'It was formed in Porto Alegre, with Humberto Gessinger on vocals.',clue2Text:'It u\xf3z f\xf3rmd in Porto Alegre, uid Humberto Gessinger on v\xf4ucolz.',clue2Translation:'Ela foi formada em Porto Alegre, com Humberto Gessinger nos vocais.',clue3Title:'Its songs include Infinita Highway, O Papa \xc9 Pop, and Piano Bar.',clue3Text:'Its s\xf3ngz incl\xfad Infinita R\xe1iu\xeai, O Papa \xc9 Pop, \xe9nd Piano Bar.',clue3Translation:'Suas m\xfasicas incluem Infinita Highway, O Papa \xc9 Pop e Piano Bar.'},{id:89,wordName:'SKANK',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band mixed rock, pop, reggae, and ska.',clue1Text:'Dis b\xe9nd mikst r\xf3k, p\xf3p, r\xe9guei, \xe9nd sk\xe1.',clue1Translation:'Esta banda misturou rock, pop, reggae e ska.',clue2Title:'It was formed in Belo Horizonte and had Samuel Rosa as its lead singer.',clue2Text:'It u\xf3z f\xf3rmd in Belo Horizonte \xe9nd r\xe9d Samuel Rosa \xe9z its l\xedd s\xednger.',clue2Translation:'Ela foi formada em Belo Horizonte e tinha Samuel Rosa como vocalista.',clue3Title:'Its hits include Garota Nacional, Vou Deixar, and Sutilmente.',clue3Text:'Its r\xedts incl\xfad Garota Nacional, Vou Deixar, \xe9nd Sutilmente.',clue3Translation:'Seus sucessos incluem Garota Nacional, Vou Deixar e Sutilmente.'},{id:90,wordName:'JOTA QUEST',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band combines pop rock with soul and funk influences.',clue1Text:'Dis b\xe9nd comb\xe1inz p\xf3p r\xf3k uid s\xf4ul \xe9nd f\xe2nk \xednfluensiz.',clue1Translation:'Esta banda combina pop rock com influ\xeancias de soul e funk.',clue2Title:'It was formed in Belo Horizonte, with Rog\xe9rio Flausino on vocals.',clue2Text:'It u\xf3z f\xf3rmd in Belo Horizonte, uid Rog\xe9rio Flausino on v\xf4ucolz.',clue2Translation:'Ela foi formada em Belo Horizonte, com Rog\xe9rio Flausino nos vocais.',clue3Title:'Its hits include F\xe1cil, Dias Melhores, and S\xf3 Hoje.',clue3Text:'Its r\xedts incl\xfad F\xe1cil, Dias Melhores, \xe9nd S\xf3 Hoje.',clue3Translation:'Seus sucessos incluem F\xe1cil, Dias Melhores e S\xf3 Hoje.'},{id:91,wordName:'CHARLIE BROWN JR.',gameTypeId:'namesOfBrazilianRock',clue1Title:'Skateboarding culture had a strong influence on this band.',clue1Text:'Sk\xeaitb\xf3rdin c\xe2ltcher r\xe9d a str\xf3ng \xednfluens on dis b\xe9nd.',clue1Translation:'A cultura do skate teve uma forte influ\xeancia sobre esta banda.',clue2Title:'It came from Santos and mixed rock, rap, reggae, and punk.',clue2Text:'It k\xeaim fr\xe2m Santos \xe9nd mikst r\xf3k, r\xe9p, r\xe9guei, \xe9nd p\xe2nk.',clue2Translation:'Ela veio de Santos e misturou rock, rap, reggae e punk.',clue3Title:'Chor\xe3o was its lead singer, and its hits include S\xf3 os Loucos Sabem.',clue3Text:'Chor\xe3o u\xf3z its l\xedd s\xednger, \xe9nd its r\xedts incl\xfad S\xf3 os Loucos Sabem.',clue3Translation:'Chor\xe3o era seu vocalista, e seus sucessos incluem S\xf3 os Loucos Sabem.'},{id:92,wordName:'PITTY',gameTypeId:'namesOfBrazilianRock',clue1Title:'This singer became known for powerful vocals and a rebellious image.',clue1Text:'Dis s\xednger bic\xeaim n\xf4un f\xf3r p\xe1uerfol v\xf4ucolz \xe9nd a rib\xe9li\xe3s \xedmidj.',clue1Translation:'Esta cantora ficou conhecida pelos vocais potentes e por uma imagem rebelde.',clue2Title:'She came from Salvador and released the album Admir\xe1vel Chip Novo.',clue2Text:'Shi k\xeaim fr\xe2m Salvador \xe9nd ril\xedst di \xe9lbam Admir\xe1vel Chip Novo.',clue2Translation:'Ela veio de Salvador e lan\xe7ou o \xe1lbum Admir\xe1vel Chip Novo.',clue3Title:'Her hits include M\xe1scara, Equalize, and Me Adora.',clue3Text:'R\xe2r r\xedts incl\xfad M\xe1scara, Equalize, \xe9nd Me Adora.',clue3Translation:'Seus sucessos incluem M\xe1scara, Equalize e Me Adora.'},{id:93,wordName:'CPM 22',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band became popular with fast guitars and emotional lyrics.',clue1Text:'Dis b\xe9nd bic\xeaim p\xf3piular uid f\xe9st guit\xe1rz \xe9nd im\xf4ushonol l\xedriks.',clue1Translation:'Esta banda se tornou popular com guitarras r\xe1pidas e letras emocionais.',clue2Title:'Badau\xed is its lead singer, and its sound is linked to melodic hardcore.',clue2Text:'Badau\xed iz its l\xedd s\xednger, \xe9nd its s\xe1und iz linkt tu mel\xf3dik r\xe1rdc\xf3r.',clue2Translation:'Badau\xed \xe9 seu vocalista, e seu som est\xe1 ligado ao hardcore mel\xf3dico.',clue3Title:'Its hits include Um Minuto para o Fim do Mundo and Dias Atr\xe1s.',clue3Text:'Its r\xedts incl\xfad Um Minuto para o Fim do Mundo \xe9nd Dias Atr\xe1s.',clue3Translation:'Seus sucessos incluem Um Minuto para o Fim do Mundo e Dias Atr\xe1s.'},{id:94,wordName:'DETONAUTAS ROQUE CLUBE',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band from Rio de Janeiro became widely known in the early two thousands.',clue1Text:'Dis b\xe9nd fr\xe2m Rio de Janeiro bic\xeaim u\xe1idli n\xf4un in di \xe2rli t\xfa th\xe1uzandz.',clue1Translation:'Esta banda do Rio de Janeiro ficou amplamente conhecida no in\xedcio dos anos dois mil.',clue2Title:'Tico Santa Cruz is its lead singer.',clue2Text:'Tico Santa Cruz iz its l\xedd s\xednger.',clue2Translation:'Tico Santa Cruz \xe9 seu vocalista.',clue3Title:'Its hits include Outro Lugar, Quando o Sol Se For, and Voc\xea Me Faz T\xe3o Bem.',clue3Text:'Its r\xedts incl\xfad Outro Lugar, Quando o Sol Se For, \xe9nd Voc\xea Me Faz T\xe3o Bem.',clue3Translation:'Seus sucessos incluem Outro Lugar, Quando o Sol Se For e Voc\xea Me Faz T\xe3o Bem.'},{id:95,wordName:'SEPULTURA',gameTypeId:'namesOfBrazilianRock',clue1Title:'This Brazilian metal band achieved worldwide recognition.',clue1Text:'Dis Braz\xedlian m\xe9tol b\xe9nd atch\xedvd u\xe2rldu\xe1id r\xe9kagn\xedshon.',clue1Translation:'Esta banda brasileira de metal alcan\xe7ou reconhecimento mundial.',clue2Title:'It was formed in Belo Horizonte by brothers Max and Igor Cavalera.',clue2Text:'It u\xf3z f\xf3rmd in Belo Horizonte bai br\xe2derz Max \xe9nd Igor Cavalera.',clue2Translation:'Ela foi formada em Belo Horizonte pelos irm\xe3os Max e Igor Cavalera.',clue3Title:'Its famous albums include Arise, Chaos A.D., and Roots.',clue3Text:'Its f\xeaimos \xe9lbamz incl\xfad Ar\xe1iz, K\xeaios \xcai D\xed, \xe9nd R\xfats.',clue3Translation:'Seus \xe1lbuns famosos incluem Arise, Chaos A.D. e Roots.'},{id:96,wordName:'OS MUTANTES',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band became known for psychedelic sounds and musical experimentation.',clue1Text:'Dis b\xe9nd bic\xeaim n\xf4un f\xf3r saicad\xe9lik s\xe1undz \xe9nd mi\xfazicol iksperiment\xeaishon.',clue1Translation:'Esta banda ficou conhecida por sons psicod\xe9licos e experimenta\xe7\xe3o musical.',clue2Title:'It was part of Tropic\xe1lia and included Rita Lee, Arnaldo Baptista, and S\xe9rgio Dias.',clue2Text:'It u\xf3z p\xe1rt \xf3v Tropic\xe1lia \xe9nd incl\xfadid Rita Lee, Arnaldo Baptista, \xe9nd S\xe9rgio Dias.',clue2Translation:'Ela fez parte da Tropic\xe1lia e contou com Rita Lee, Arnaldo Baptista e S\xe9rgio Dias.',clue3Title:'Its recordings include Panis et Circencis and Ando Meio Desligado.',clue3Text:'Its ric\xf3rdingz incl\xfad Panis et Circencis \xe9nd Ando Meio Desligado.',clue3Translation:'Suas grava\xe7\xf5es incluem Panis et Circencis e Ando Meio Desligado.'},{id:97,wordName:'LULU SANTOS',gameTypeId:'namesOfBrazilianRock',clue1Title:'This singer and guitarist built a career mixing pop and rock.',clue1Text:'Dis s\xednger \xe9nd guit\xe1rist bilt a car\xedr m\xedksin p\xf3p \xe9nd r\xf3k.',clue1Translation:'Este cantor e guitarrista construiu uma carreira misturando pop e rock.',clue2Title:'He wrote Como uma Onda with Nelson Motta.',clue2Text:'Ri r\xf4ut Como uma Onda uid Nelson Motta.',clue2Translation:'Ele escreveu Como uma Onda com Nelson Motta.',clue3Title:'His hits also include Tempos Modernos, Toda Forma de Amor, and Apenas Mais uma de Amor.',clue3Text:'Riz r\xedts \xf3lsou incl\xfad Tempos Modernos, Toda Forma de Amor, \xe9nd Apenas Mais uma de Amor.',clue3Translation:'Seus sucessos tamb\xe9m incluem Tempos Modernos, Toda Forma de Amor e Apenas Mais uma de Amor.'},{id:98,wordName:'NANDO REIS',gameTypeId:'namesOfBrazilianRock',clue1Title:'This red-haired musician wrote songs recorded by several Brazilian artists.',clue1Text:'Dis r\xe9d-r\xe9rd miuz\xedshan r\xf4ut s\xf3ngz ric\xf3rdid bai s\xe9vrol Braz\xedlian \xe1rtists.',clue1Translation:'Este m\xfasico ruivo escreveu m\xfasicas gravadas por v\xe1rios artistas brasileiros.',clue2Title:'He played bass in Tit\xe3s before focusing on his solo career.',clue2Text:'Ri pl\xeaid b\xeaiss in Tit\xe3s bif\xf3r f\xf4ucassin on riz s\xf4ulou car\xedr.',clue2Translation:'Ele tocou baixo nos Tit\xe3s antes de se concentrar em sua carreira solo.',clue3Title:'He performs with Os Infernais and wrote Relic\xe1rio and All Star.',clue3Text:'Ri perf\xf3rmz uid Os Infernais \xe9nd r\xf4ut Relic\xe1rio \xe9nd \xd3l St\xe1r.',clue3Translation:'Ele se apresenta com Os Infernais e escreveu Relic\xe1rio e All Star.'},{id:99,wordName:'C\xc1SSIA ELLER',gameTypeId:'namesOfBrazilianRock',clue1Title:'This singer was known for a deep voice and intense performances.',clue1Text:'Dis s\xednger u\xf3z n\xf4un f\xf3r a d\xedp v\xf3iss \xe9nd int\xe9ns perf\xf3rmansiz.',clue1Translation:'Esta cantora era conhecida pela voz grave e por apresenta\xe7\xf5es intensas.',clue2Title:'Her acoustic album included a famous version of Malandragem.',clue2Text:'R\xe2r ac\xfastik \xe9lbam incl\xfadid a f\xeaimos v\xe2rjon \xf3v Malandragem.',clue2Translation:'Seu \xe1lbum ac\xfastico incluiu uma famosa vers\xe3o de Malandragem.',clue3Title:'She also made songs like Segundo Sol and Palavras ao Vento famous.',clue3Text:'Shi \xf3lsou m\xeaid s\xf3ngz l\xe1ik Segundo Sol \xe9nd Palavras ao Vento f\xeaimos.',clue3Translation:'Ela tamb\xe9m tornou famosas m\xfasicas como Segundo Sol e Palavras ao Vento.'},{id:100,wordName:'MAMONAS ASSASSINAS',gameTypeId:'namesOfBrazilianRock',clue1Title:'This band mixed rock with humor and several other musical styles.',clue1Text:'Dis b\xe9nd mikst r\xf3k uid ri\xfamor \xe9nd s\xe9vrol \xe2der mi\xfazicol st\xe1 ilz.',clue1Translation:'Esta banda misturou rock com humor e v\xe1rios outros estilos musicais.',clue2Title:'Its five members came from Guarulhos, and Dinho was the lead singer.',clue2Text:'Its f\xe1iv m\xe9mberz k\xeaim fr\xe2m Guarulhos, \xe9nd Dinho u\xf3z d\xea l\xedd s\xednger.',clue2Translation:'Seus cinco integrantes vieram de Guarulhos, e Dinho era o vocalista.',clue3Title:'Its hits include Pelados em Santos, Vira-Vira, and Robocop Gay.',clue3Text:'Its r\xedts incl\xfad Pelados em Santos, Vira-Vira, \xe9nd Robocop Gay.',clue3Translation:'Seus sucessos incluem Pelados em Santos, Vira-Vira e Robocop Gay.'}]},865);
